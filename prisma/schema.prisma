generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CollectedColor {
  id             String   @id @default(cuid())
  sampledHex     String // 実際にタップした点から採取した色
  matchedName    String // 照合した伝統色名（例: "蘇芳"）
  matchedReading String // ローマ字読み（例: "suoh"）
  matchedHex     String // 伝統色の正式なHEX
  distance       Float // マッチ距離（近さの参考値）
  thumbnail      String   @db.Text // 圧縮JPEGのbase64データURL
  latitude       Float?
  longitude      Float?
  locationName   String? // 逆ジオコーディングで得た地名（取得できた場合のみ）
  elevation      Float? // 標高（メートル）。端末のGPS値、なければ地形データから取得
  note           String? // 撮影時に付けたメモ
  genre          String? // 撮影物のジャンル（木・土・石など、手動選択）
  capturedAt     DateTime @default(now())

  @@index([capturedAt(sort: Desc)])
  @@index([matchedName])
}
